# Backend environment (copy to .env and fill in; never commit .env)

# Base Sepolia RPC endpoint. Public endpoint works for light use;
# for a provider key use e.g. https://base-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed AssetRegistry on Base Sepolia
ASSET_REGISTRY_ADDRESS=0x61bfab5D232429512c4D183a05Ec22F7e64B1562

# Oracle wallet private key (the address must hold CONSENSUS_ROLE on AssetRegistry).
# Use a fresh testnet-only key.
ORACLE_WALLET_PRIVATE_KEY=

# Token minter (optional). If unset, minting runs in simulation mode.
SEPOLIA_RPC_URL=
PRIVATE_KEY_SEPOLIA=

# Oracle node URL used by the registry service
ORACLE_SERVICE_URL=http://localhost:8081

NETWORK=baseSepolia
CHAIN_ID=84532
BASESCAN_URL=https://sepolia.basescan.org
BASESCAN_API_URL=https://api-sepolia.basescan.org/api
