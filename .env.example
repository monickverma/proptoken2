# Web app (Vite) settings. All optional; copy to .env.local for local use.
# These are public values that end up in the browser bundle: never put secrets here.

# WalletConnect / Reown project ID (https://cloud.reown.com). Without it, only
# browser-extension wallets such as MetaMask are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# Read RPC for Base Sepolia (defaults to the public https://sepolia.base.org)
VITE_BASE_SEPOLIA_RPC_URL=

# Which file in proptoken-autonomous/contracts/deployments/ to use (default: base-sepolia)
VITE_DEPLOYMENT=

# Express demo API: JWT signing secret (required in production)
JWT_SECRET=
